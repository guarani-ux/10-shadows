{
  "pre-tool-audit-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python ../scripts/verify_plan_audit.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}